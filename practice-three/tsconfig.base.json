{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@practice-three/features/authentication": ["libs/authentication/src/index.ts"],
      "@practice-three/features/order": ["libs/order/src/index.ts"],
      "@practice-three/features/product": ["libs/product/src/index.ts"],
      "@practice-three/features/profile": ["libs/profile/src/index.ts"],
      "@practice-three/features/wishlist": ["libs/wishlist/src/index.ts"],
      "@practice-three/shared/asset": ["libs/shared/asset/src/index.ts"],
      "@practice-three/shared/config": ["libs/shared/config/src/index.ts"],
      "@practice-three/shared/constant": ["libs/shared/constant/src/index.ts"],
      "@practice-three/shared/context": ["libs/shared/context/src/index.ts"],
      "@practice-three/shared/hook": ["libs/shared/hook/src/index.ts"],
      "@practice-three/shared/query": ["libs/shared/query/src/index.ts"],
      "@practice-three/shared/service": ["libs/shared/service/src/index.ts"],
      "@practice-three/shared/types": ["libs/shared/types/src/index.ts"],
      "@practice-three/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@practice-three/shared/util": ["libs/shared/util/src/index.ts"],
      "@practice-three/shell": ["libs/shell/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
